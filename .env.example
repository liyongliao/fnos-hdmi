DESKTOP_USER=ubuntu
DESKTOP_UID=1000
DESKTOP_GID=1000
DESKTOP_PASSWORD=replace-with-a-strong-password
# 3391 第一层 RDP 验证；新手直接设置成与 DESKTOP 相同即可
REMOTE_LOGIN_USER=ubuntu
REMOTE_LOGIN_PASSWORD=replace-with-a-strong-password
DESKTOP_HOME=/vol1/1000/docker/ubuntu
DESKTOP_IMAGE=fnos-ubuntu26-gnome-hdmi:wayland-zh-custom

# Docker 兼容模式。true 最省心，适合 Waydroid/LXC/硬件直通；false 使用精细权限。
PRIVILEGED_MODE=true
# privileged=true 时仍默认隐藏额外 DRM VF，只保留 card0/renderD128 给 GNOME。
LIMIT_GPU_DEVICES=true

# 对外监听地址。0.0.0.0 表示 fnOS 所有网卡都可访问；也可以改成局域网/VPN IP。
BIND_ADDRESS=0.0.0.0
RDP_PORT=3389
DESKTOP_SHARING_PORT=3390
REMOTE_LOGIN_PORT=3391
WEB_PORT=8080
WEB_MEMORY_LIMIT=1g
GUACD_MEMORY_LIMIT=512m

REMOTE_MODE=both
AUTO_LOGIN=true
SCREEN_SHARE_MODE=mirror-primary
# 禁止 Ubuntu 二次挂载 fnOS 已挂载的 /dev/dm-*；由 setup-storage.sh 映射目录
DISABLE_UDISKS=true
NAS_STORAGE_MODE=rw

# fnOS 当前内核的 binder 字符设备主设备号；quick-start.sh 会自动检测
BINDER_DEVICE_MAJOR=243
# Waydroid Android 镜像和应用数据持久化目录
WAYDROID_DATA=./waydroid-data
# 可选：将一个 NAS 目录暴露给 Android APP；留空表示禁用
WAYDROID_MEDIA_SOURCE=
WAYDROID_MEDIA_TARGET=Pictures/nas
# 照片库建议 ro；只有确实需要 Android 写入时才改为 rw
WAYDROID_MEDIA_MODE=ro
# 0 禁用 MediaStore 扫描；其他数值为自动刷新秒数（默认 30 分钟）
WAYDROID_MEDIA_SCAN_INTERVAL=1800

# 主 GNOME/Waydroid 桌面默认不设置 RAM、swap、PID 硬上限。
# 如果确实需要限制，请使用 compose.resource-limits.yaml 叠加配置。
DESKTOP_MEMORY_LIMIT=12g
DESKTOP_MEMORY_SWAP_LIMIT=16g
DESKTOP_PIDS_LIMIT=16384

# Optional derived image (used with compose.extras.yaml)
BASE_DESKTOP_IMAGE=fnos-ubuntu26-gnome-hdmi:wayland-zh
CUSTOM_DESKTOP_IMAGE=fnos-ubuntu26-gnome-hdmi:wayland-zh-custom
INSTALL_APP_STORE=true
INSTALL_GOOGLE_CHROME=true
INSTALL_WAYDROID=false
WAYDROID_DISTRO=resolute
# In networks where dl.google.com is unavailable, replace this with a trusted
# mirror URL that serves the official current amd64 .deb.
CHROME_DEB_URL=https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
