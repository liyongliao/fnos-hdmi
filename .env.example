DESKTOP_USER=ubuntu
DESKTOP_UID=1000
DESKTOP_GID=1000
DESKTOP_PASSWORD=replace-with-a-strong-password
# 3391 第一层 RDP 验证；新手直接设置成与 DESKTOP 相同即可
REMOTE_LOGIN_USER=ubuntu
REMOTE_LOGIN_PASSWORD=replace-with-a-strong-password
DESKTOP_HOME=/vol1/1000/docker/ubuntu
DESKTOP_IMAGE=fnos-ubuntu26-gnome-hdmi:wayland-zh-custom
RDP_PORT=3389
DESKTOP_SHARING_PORT=3390
REMOTE_LOGIN_PORT=3391
WEB_PORT=8080
MEMORY_LIMIT=4g
PIDS_LIMIT=2048
WEB_MEMORY_LIMIT=768m
GUACD_MEMORY_LIMIT=256m
REMOTE_MODE=both
AUTO_LOGIN=true
SCREEN_SHARE_MODE=mirror-primary
# 禁止 Ubuntu 二次挂载 fnOS 已挂载的 /dev/dm-*；由 setup-storage.sh 安全映射
DISABLE_UDISKS=true
# NAS 目录读写模式；只需要读取时改成 ro
NAS_STORAGE_MODE=rw

# Optional derived image (used with compose.extras.yaml)
BASE_DESKTOP_IMAGE=fnos-ubuntu26-gnome-hdmi:wayland-zh
CUSTOM_DESKTOP_IMAGE=fnos-ubuntu26-gnome-hdmi:wayland-zh-custom
INSTALL_APP_STORE=true
INSTALL_GOOGLE_CHROME=true
# In networks where dl.google.com is unavailable, replace this with a trusted
# mirror URL that serves the official current amd64 .deb.
CHROME_DEB_URL=https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
